MC_USERNAME=
MC_PASSWORD=

# Preferido: conecta no Supabase sem depender do token administrativo.
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_REGION=
SUPABASE_DB_PASSWORD=

# Alternativas caso prefira configurar a conexao completa do banco.
DATABASE_URL=
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_SSLMODE=require

# Fallback antigo. Nao precisa se SUPABASE_PROJECT_REF/DATABASE_URL estiver configurado.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_NAME=

KIRVANO_WEBHOOK_TOKEN=

TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# Copia de testes: 1 = nada sai no WhatsApp e nenhuma linha e apagada do painel MC.
PEIXEIRO_MODO_TESTE=

# Encurtador (urtador). A chave publica ja vem no codigo; o token e opcional.
URTADOR_API_URL=
URTADOR_API_KEY=
URTADOR_BASE_URL=https://kuttenc.github.io/urtador
URTADOR_TOKEN=
URTADOR_SESSAO=

# A senha e os dados do WhatsApp que abrem um banco zerado. Em branco ele sorteia a senha
# e imprime no log; o resto fica vazio e ele preenche pela aba Config.
PAINEL_SENHA_INICIAL=
GREENAPI_API_URL=
GREENAPI_MEDIA_URL=
GREENAPI_ID_INSTANCE=
GREENAPI_OWNER_PHONE=
